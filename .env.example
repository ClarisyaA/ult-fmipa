# Node & Next.js Environment
NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-secure-secret-key-in-production
# Set to "true" to enable verbose NextAuth/PAUS debug logging. Keep unset
# (or "false") in staging/production - do not enable in shared environments.
AUTH_DEBUG=false

# Database Configuration (MariaDB)
DATABASE_URL="mysql://ult_user:ult_password@db:3306/fmipa_sbpk"
DB_HOST=db
DB_PORT=3306
DB_USER=ult_user
DB_PASSWORD=ult_password
DB_NAME=fmipa_sbpk
# Prisma connection pool size (src/lib/prisma.ts). Tune per environment.
DB_CONNECTION_LIMIT=10
# Set to "true" to log every Prisma query. Verbose - local debugging only.
PRISMA_QUERY_LOG=false

# Storage & Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# MinIO Object Storage Configuration
# Local Non-Docker Development default (Next.js on host, MinIO in Docker with published ports):
MINIO_ENDPOINT=localhost
# Docker Compose (app service talking to the `minio` service on the compose network):
# MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# DEVELOPMENT PLACEHOLDER ONLY - do not use these values in staging/production.
# Generate a unique access key/secret key per environment instead.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ult-fmipa

# Development Accounts (NextAuth Credentials Provider, local/testing only)
# DEVELOPMENT PLACEHOLDER ONLY - these are not real accounts and must not be
# reused in staging/production. PAUS/Unpad SSO is the real login path once
# activated for those environments.
DEV_ADMIN_EMAIL=admin@gmail.com
DEV_ADMIN_PASSWORD=admin123
DEV_STAFF_EMAIL=staff@gmail.com
DEV_STAFF_PASSWORD=staff123
DEV_STUDENT_EMAIL=student@gmail.com
DEV_STUDENT_PASSWORD=student123
DEV_STUDENT_NAME=Mahasiswa ULT
DEV_STUDENT_NPM=140810230017
DEV_STUDENT_PHONE=

# Access Control Access Codes
# NOTE: not currently read by any application code (role resolution now uses
# the APP_ROLE column on data_users, see src/lib/roles.ts and migration
# 009_add_app_role_to_data_users.sql). Left here for backward compatibility
# with older deployment scripts; safe to ignore.
DB_ADMIN_ACCESS_CODES=SUPER_USER
DB_STAFF_ACCESS_CODES=ADMIN,OPERATOR,KRS,PIMPINAN

# PAUS SSO / OAuth Integration Placeholders
PAUS_MODE=modern
PAUS_CLIENT_ID=
PAUS_CLIENT_SECRET=
# Endpoint mengikuti "Panduan Integrasi PAuS SSO" v1.0 (18 Juni 2026). Bila DPSI
# meminta memakai endpoint lama, ganti ke /oauth, /oauth/access-token, /api/ dan
# set PAUS_SCOPE=user.basic serta PAUS_USERINFO_AUTH=query.
PAUS_AUTHORIZATION_URL=https://paus.unpad.ac.id/oauth/authorize
PAUS_TOKEN_URL=https://paus.unpad.ac.id/oauth/token
PAUS_USERINFO_URL=https://paus.unpad.ac.id/api/user
PAUS_SIGN_OUT_URL=https://paus.unpad.ac.id/oauth/sign-out
PAUS_SCOPE=read-user-info
# "bearer" (header Authorization: Bearer, sesuai panduan) atau "query" (?access_token=, gaya lama)
PAUS_USERINFO_AUTH=bearer
# Logout aplikasi ikut mengakhiri sesi PAuS lalu kembali ke beranda. "false" = hanya logout lokal.
PAUS_GLOBAL_LOGOUT=true
# Nama parameter URL tujuan pada sign-out PAuS (default redirect_uri).
PAUS_SIGN_OUT_REDIRECT_PARAM=redirect_uri
# Penolakan alumni memakai penanda dari PAuS. Kosong = nonaktif. Isi setelah DPSI
# menyebut nama field-nya, mis. PAUS_ALUMNI_FIELD=status dan PAUS_ALUMNI_VALUES=alumni,lulus
# (atau PAUS_ACTIVE_VALUES=aktif untuk hanya menerima nilai tertentu).
PAUS_ALUMNI_FIELD=
PAUS_ALUMNI_VALUES=alumni,lulus
PAUS_ACTIVE_VALUES=
# OIDC issuer identifier used by src/lib/auth.ts when PAUS_MODE=modern.
# No default in code (process.env.PAUS_ISSUER, no fallback) - value must be
# confirmed with the PAUS/Unpad SSO team, do not assume it matches the
# authorization/token URLs above.
PAUS_ISSUER=
PAUS_LEGACY_LOGIN_URL=
# PAuS Bridge (alur PHP lama) MATI secara default. Isi "true" hanya bila sistem lama
# masih dipakai, dan wajib mengganti PAUS_BRIDGE_SECRET dengan nilai acak.
PAUS_BRIDGE_ENABLED=false
PAUS_BRIDGE_SECRET=change-this-bridge-secret-key
PAUS_BRIDGE_TOKEN_TTL_SECONDS=120
# Setelah login PAUS, NPM harus ada di tabel `mahasiswa` (sama seperti ULT lama).
# Isi "false" HANYA sementara, misalnya bila data mahasiswa baru belum diimpor.
PAUS_REQUIRE_REGISTERED_NPM=true

# Sinkron data mahasiswa otomatis dari sistem lain (POST /api/internal/mahasiswa-sync).
# Kosongkan untuk menonaktifkan. Bila diisi, minimal 32 karakter acak, mis.:
#   openssl rand -base64 48
# Unggah Excel oleh Admin/Staff tetap bisa dipakai walaupun ini kosong.
MAHASISWA_SYNC_TOKEN=
