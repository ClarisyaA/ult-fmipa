model transkrip {
  ID               BigInt    @id @default(autoincrement())
  NPM              String?   @db.VarChar(15)
  TGL_LULUS        DateTime? @db.Date
  PERMINTAAN_TGL   DateTime? @db.Timestamp(0)
  PERMINTAAN_ENTRY String?   @db.VarChar(100)
  PERMINTAAN_IP    String?   @db.VarChar(20)
  VERIFIKASI_TGL   DateTime? @db.Timestamp(0)
  VERIFIKASI_STAF  String?   @db.VarChar(100)
  FAKULTAS_TGL     DateTime? @db.Timestamp(0)
  FAKULTAS_STAF    String?   @db.VarChar(100)
  UNIVERSITAS_TGL  DateTime? @db.Timestamp(0)
  UNIVERSITAS_STAF String?   @db.VarChar(100)
  DIAMBIL_TGL      DateTime? @db.Timestamp(0)
  DIAMBIL_OLEH     String?   @db.VarChar(100)
}

model unggah_karya_ilmiah {
  ID               BigInt    @id @default(autoincrement())
  NPM              String?   @db.VarChar(15)
  PERMINTAAN_TGL   DateTime? @db.Timestamp(0)
  PERMINTAAN_ENTRY String?   @db.VarChar(100)
  PERMINTAAN_IP    String?   @db.VarChar(20)
  KETERANGAN       String?   @db.VarChar(100)
  EMAIL            String?   @db.VarChar(100)
  HP_WA            String?   @db.VarChar(100)
  PROSES_TGL       DateTime? @db.Timestamp(0)
  PROSES_STAF      String?   @db.VarChar(100)
  SELESAI_TGL      DateTime? @db.Timestamp(0)
  SELESAI_STAF     String?   @db.VarChar(100)
  DIKIRIM_TGL      DateTime? @db.Timestamp(0)
  DIKIRIM_OLEH     String?   @db.VarChar(100)
}

model yudisium {
  ID       BigInt  @id @default(autoincrement())
  YUDISIUM String? @db.VarChar(255)
}
