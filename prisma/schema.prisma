generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model alumni {
  id                     Int       @id @default(autoincrement())
  nama                   String    @default("") @db.VarChar(50)
  tmp_lhr                String?   @db.VarChar(30)
  tgl_lhr                DateTime  @default(dbgenerated("('0000-00-00')")) @db.Date
  npm                    String?   @db.VarChar(15)
  program                String?   @db.VarChar(30)
  prodi                  String?   @db.VarChar(45)
  tgl_sidang             DateTime? @default(dbgenerated("('0000-00-00')")) @db.Date
  tgl_wisuda             DateTime? @default(dbgenerated("('0000-00-00')")) @db.Date
  tahun_masuk            Int?
  tahun_lulus            Int?
  alamat                 String?   @db.VarChar(200)
  kota                   String?   @db.VarChar(30)
  email                  String?   @db.VarChar(30)
  telp                   String?   @db.VarChar(15)
  instansi               String?   @db.VarChar(30)
  Jabatan                String?   @db.VarChar(25)
  alm_inst               String?   @db.VarChar(50)
  email_inst             String?   @db.VarChar(30)
  tlp_inst               String?   @db.VarChar(15)
  wkt_tunggu             DateTime? @default(dbgenerated("('0000-00-00')")) @db.Date
  waktu_tunggu_pekerjaan String?   @db.VarChar(30)
  gaji                   String?   @db.VarChar(25)
  sesuai                 String?   @db.VarChar(10)
  tgl_entri              DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  status_isi             Int       @default(1) @db.UnsignedInt
}

