# Local staging rehearsal - environment template.
#
# Copy this file to `staging-local.env` (gitignored) and fill in local-only
# values. This file feeds `${VAR}` substitution in docker-compose.yml +
# docker-compose.staging-local.yml when run via:
#
#   docker compose -p ult-fmipa-staging-local --env-file staging-local.env \
#     -f docker-compose.yml -f docker-compose.staging-local.yml <command>
#
# or simply: pnpm staging:local:up
#
# This is a LOCAL STAGING REHEARSAL, not the real VPS staging environment.
# Database/bucket names and ports are hardcoded in
# docker-compose.staging-local.yml so they can never accidentally match
# local development or a real deployment.
#
# Do not put real/production secrets here. Do not commit the filled-in
# staging-local.env file (it is gitignored).

STAGING_LOCAL=true
NODE_ENV=production

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3100
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=<GENERATE_LOCAL_STAGING_SECRET>
AUTH_DEBUG=false

# --- Database (MariaDB, internal Compose network host is always `db`) ---
DB_USER=<LOCAL_STAGING_DB_USER>
DB_PASSWORD=<LOCAL_STAGING_DB_PASSWORD>
# Root password for the `db` container only; not used by the app.
DB_ROOT_PASSWORD=<LOCAL_STAGING_DB_ROOT_PASSWORD>
DB_CONNECTION_LIMIT=10
PRISMA_QUERY_LOG=false
# DB_NAME is fixed to fmipa_sbpk_staging_local in docker-compose.staging-local.yml.

# --- MinIO (internal Compose network host is always `minio`) ---
MINIO_ACCESS_KEY=<LOCAL_STAGING_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<LOCAL_STAGING_MINIO_SECRET_KEY>
# MINIO_BUCKET is fixed to ult-fmipa-staging-local in docker-compose.staging-local.yml.

MAX_UPLOAD_SIZE_MB=10

# --- PAUS SSO / OAuth (optional) ---
# Leave blank to run Admin/Staff login through the database credentials
# path only (src/lib/auth.ts only registers the PAUS OAuth provider when
# PAUS_CLIENT_ID and PAUS_CLIENT_SECRET are both non-empty - leaving them
# blank does not crash the app). Do NOT invent values here; only fill these
# in if you have real PAUS staging/sandbox credentials to rehearse against.
PAUS_CLIENT_ID=
PAUS_CLIENT_SECRET=
PAUS_ISSUER=
PAUS_LEGACY_LOGIN_URL=
# Bridge secret is required by src/lib/auth.ts's "paus-bridge" credentials
# provider even when PAUS OAuth itself is not configured. Generate a random
# local value; do not reuse the development or production bridge secret.
PAUS_BRIDGE_SECRET=<GENERATE_LOCAL_STAGING_BRIDGE_SECRET>

# --- Explicitly NOT used in local staging ---
# DEV_ADMIN_*, DEV_STAFF_*, and DEV_STUDENT_* are hardcoded to empty strings
# in docker-compose.staging-local.yml regardless of this file or the host
# shell environment, so they can never become a login mechanism here. Do not
# add them back.
