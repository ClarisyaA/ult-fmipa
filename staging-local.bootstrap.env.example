# Local staging rehearsal - one-time Admin bootstrap credentials template.
#
# Copy this file to `staging-local.bootstrap.env` (gitignored) and fill in a
# password you control. This file is only read by
# `pnpm staging:local:bootstrap-admin` (scripts/staging-local/bootstrap-admin.mjs)
# to create the FIRST Admin account directly in the local staging database.
# It is never loaded into the running app container's environment.
#
# After the Admin account is created and you have confirmed you can log in,
# delete this file's contents or the file itself (see
# docs/local-staging-rehearsal.md, "Cleanup credential bootstrap").
#
# Do not commit the filled-in staging-local.bootstrap.env file (gitignored).
# Do not set a default/guessable password.

# Maps to data_users.USER_NAME (max 20 chars).
STAGING_BOOTSTRAP_ADMIN_USERNAME=
# Maps to data_users.EMAIL (max 50 chars).
STAGING_BOOTSTRAP_ADMIN_EMAIL=
# Maps to data_users.FULL_NAME (max 50 chars).
STAGING_BOOTSTRAP_ADMIN_NAME=
# Plaintext password, minimum 8 characters (same rule as the admin user
# management API). Hashed with the app's existing legacy SHA-1 convention
# (src/lib/auth-db-users.ts hashLegacyPassword) before it ever touches the
# database - the plaintext value is never logged or persisted.
STAGING_BOOTSTRAP_ADMIN_PASSWORD=

# Optional overrides - only set these if you know the values already exist
# in the local staging database (e.g. after importing the legacy baseline).
# Maps to data_users.ACCESS_CODE; must already exist in the data_access
# table. Defaults to SUPER_USER if left blank.
STAGING_BOOTSTRAP_ADMIN_ACCESS_CODE=
# Maps to data_users.UNIT_ID; must already exist in the data_unit table.
# If left blank, the script picks the lowest existing UNIT_ID automatically.
STAGING_BOOTSTRAP_ADMIN_UNIT_ID=
